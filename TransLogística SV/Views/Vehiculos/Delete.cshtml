@model TransLogística_SV.Models.Vehiculo

@{
    ViewData["Title"] = "Eliminar vehículo";
}

<div class="container mt-4">

    <h1>Eliminar vehículo</h1>

    <div class="alert alert-danger mt-3">
        ¿Está seguro de que desea eliminar este vehículo?
    </div>

    <div class="card">

        <div class="card-body">

            <h4>@Model.TipoVehiculo</h4>

            <p>
                <strong>Placa:</strong>
                @Model.Placa
            </p>

            <p>
                <strong>Marca:</strong>
                @Model.Marca
            </p>

            <p>
                <strong>Modelo:</strong>
                @Model.Modelo
            </p>

            <p>
                <strong>Año:</strong>
                @Model.Anio
            </p>

        </div>

    </div>

    <form asp-action="Delete"
          method="post"
          class="mt-3">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="placa"
               value="@Model.Placa" />

        <button type="submit"
                class="btn btn-danger">
            Sí, eliminar
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancelar
        </a>

    </form>

</div>