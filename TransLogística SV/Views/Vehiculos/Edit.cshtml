@model TransLogística_SV.Models.VehiculoViewModel

@{
    ViewData["Title"] = "Editar vehículo";
}

<div class="container mt-4">

    <h1>Editar vehículo</h1>

    <form asp-action="Edit" method="post">

        @Html.AntiForgeryToken()

        <input type="hidden" name="placaOriginal" value="@Model.Placa" />

        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="mb-3">
            <label class="form-label">Tipo de vehículo</label>

            <input asp-for="Tipo" class="form-control" readonly />
        </div>

        <div class="mb-3">
            <label class="form-label">Placa</label>
            <input asp-for="Placa" class="form-control" />
            <span asp-validation-for="Placa" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Marca</label>
            <input asp-for="Marca" class="form-control" />
            <span asp-validation-for="Marca" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Modelo</label>
            <input asp-for="Modelo" class="form-control" />
            <span asp-validation-for="Modelo" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Año</label>
            <input asp-for="Anio" type="number" class="form-control" />
            <span asp-validation-for="Anio" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Kilometraje</label>
            <input asp-for="Kilometraje" type="number" step="0.01" class="form-control" />
            <span asp-validation-for="Kilometraje" class="text-danger"></span>
        </div>

        @if (Model.Tipo == "Camion")
        {
            <div class="mb-3">
                <label class="form-label">Capacidad de carga (toneladas)</label>
                <input asp-for="CapacidadCargaToneladas" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="CapacidadCargaToneladas" class="text-danger"></span>
            </div>
        }

        @if (Model.Tipo == "Automovil")
        {
            <div class="mb-3">
                <label class="form-label">Tipo de combustible</label>
                <select asp-for="TipoCombustible" class="form-select">
                    <option value="Gasolina Regular">Gasolina Regular</option>
                    <option value="Gasolina Premium">Gasolina Premium</option>
                    <option value="Diesel">Diesel</option>
                </select>
                <span asp-validation-for="TipoCombustible" class="text-danger"></span>
            </div>
        }

        @if (Model.Tipo == "Motocicleta")
        {
            <div class="mb-3">
                <label class="form-label">Cilindraje (cc)</label>
                <input asp-for="Cilindraje" type="number" class="form-control" />
                <span asp-validation-for="Cilindraje" class="text-danger"></span>
            </div>
        }

        <button type="submit" class="btn btn-success">Guardar cambios</button>

        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
