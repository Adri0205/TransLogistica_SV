@model TransLogística_SV.Models.VehiculoViewModel

@{
    ViewData["Title"] = "Registrar vehículo";
}

<div class="container mt-4">

    <h1>Registrar vehículo</h1>

    <form asp-action="Create" method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="mb-3">
            <label class="form-label">Tipo de vehículo</label>

            <select asp-for="Tipo"
                    id="tipo"
                    class="form-select"
                    onchange="mostrarCampos()"
                    required>

                <option value="">Seleccione un tipo</option>
                <option value="Camion">Camión</option>
                <option value="Automovil">Automóvil</option>
                <option value="Motocicleta">Motocicleta</option>

            </select>
            <span asp-validation-for="Tipo" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Placa</label>
            <input asp-for="Placa" class="form-control" />
            <span asp-validation-for="Placa" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Marca</label>
            <input asp-for="Marca" class="form-control" />
            <span asp-validation-for="Marca" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Modelo</label>
            <input asp-for="Modelo" class="form-control" />
            <span asp-validation-for="Modelo" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Año</label>
            <input asp-for="Anio" type="number" class="form-control" />
            <span asp-validation-for="Anio" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Kilometraje</label>
            <input asp-for="Kilometraje" type="number" step="0.01" class="form-control" />
            <span asp-validation-for="Kilometraje" class="text-danger"></span>
        </div>

        <!-- Datos del camión -->
        <div id="camionCampos" style="display:none">

            <div class="mb-3">
                <label class="form-label">
                    Capacidad de carga en toneladas
                </label>

                <input asp-for="CapacidadCargaToneladas" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="CapacidadCargaToneladas" class="text-danger"></span>
            </div>

        </div>

        <!-- Datos del automóvil -->
        <div id="automovilCampos" style="display:none">

            <div class="mb-3">
                <label class="form-label">
                    Tipo de combustible
                </label>

                <select asp-for="TipoCombustible" class="form-select">

                    <option value="">Seleccione</option>
                    <option value="Gasolina Regular">Gasolina Regular</option>
                    <option value="Gasolina Premium">Gasolina Premium</option>
                    <option value="Diesel">Diesel</option>

                </select>
                <span asp-validation-for="TipoCombustible" class="text-danger"></span>
            </div>

        </div>

        <!-- Datos de motocicleta -->
        <div id="motocicletaCampos" style="display:none">

            <div class="mb-3">
                <label class="form-label">
                    Cilindraje (cc)
                </label>

                <input asp-for="Cilindraje" type="number" class="form-control" />
                <span asp-validation-for="Cilindraje" class="text-danger"></span>
            </div>

        </div>

        <button type="submit" class="btn btn-success">Guardar</button>

        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function mostrarCampos() {
            var tipo = document.getElementById("tipo").value;

            document.getElementById("camionCampos").style.display = "none";
            document.getElementById("automovilCampos").style.display = "none";
            document.getElementById("motocicletaCampos").style.display = "none";

            if (tipo === "Camion") {
                document.getElementById("camionCampos").style.display = "block";
            }

            if (tipo === "Automovil") {
                document.getElementById("automovilCampos").style.display = "block";
            }

            if (tipo === "Motocicleta") {
                document.getElementById("motocicletaCampos").style.display = "block";
            }
        }

        // Muestra secciones si ya hay un valor seleccionado (cuando vuelve la vista con errores)
        document.addEventListener('DOMContentLoaded', function () {
            mostrarCampos();
        });
    </script>

}
