@{
    ViewData["Title"] = "Registrar vehículo";
}

<div class="container mt-4">

    <h1>Registrar vehículo</h1>

    <form asp-action="Create" method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="mb-3">
            <label class="form-label">Tipo de vehículo</label>

            <select name="tipo"
                    id="tipo"
                    class="form-select"
                    onchange="mostrarCampos()"
                    required>

                <option value="">Seleccione un tipo</option>
                <option value="Camion">Camión</option>
                <option value="Automovil">Automóvil</option>
                <option value="Motocicleta">Motocicleta</option>

            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Placa</label>
            <input name="placa"
                   class="form-control"
                   required />
        </div>

        <div class="mb-3">
            <label class="form-label">Marca</label>
            <input name="marca"
                   class="form-control"
                   required />
        </div>

        <div class="mb-3">
            <label class="form-label">Modelo</label>
            <input name="modelo"
                   class="form-control"
                   required />
        </div>

        <div class="mb-3">
            <label class="form-label">Año</label>
            <input name="anio"
                   type="number"
                   class="form-control"
                   required />
        </div>

        <div class="mb-3">
            <label class="form-label">Kilometraje</label>
            <input name="kilometraje"
                   type="number"
                   step="0.01"
                   class="form-control"
                   required />
        </div>

        <!-- Datos del camión -->
        <div id="camionCampos" style="display:none">

            <div class="mb-3">
                <label class="form-label">
                    Capacidad de carga en toneladas
                </label>

                <input name="capacidadCargaToneladas"
                       type="number"
                       step="0.01"
                       class="form-control" />
            </div>

        </div>

        <!-- Datos del automóvil -->
        <div id="automovilCampos" style="display:none">

            <div class="mb-3">
                <label class="form-label">
                    Tipo de combustible
                </label>

                <select name="tipoCombustible"
                        class="form-select">

                    <option value="">Seleccione</option>
                    <option value="Gasolina Regular">
                        Gasolina Regular
                    </option>

                    <option value="Gasolina Premium">
                        Gasolina Premium
                    </option>

                    <option value="Diesel">
                        Diesel
                    </option>

                </select>
            </div>

        </div>

        <!-- Datos de motocicleta -->
        <div id="motocicletaCampos" style="display:none">

            <div class="mb-3">
                <label class="form-label">
                    Cilindraje (cc)
                </label>

                <input name="cilindraje"
                       type="number"
                       class="form-control" />
            </div>

        </div>

        <button type="submit"
                class="btn btn-success">
            Guardar
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancelar
        </a>

    </form>

</div>

@section Scripts {

    <script>

        function mostrarCampos() {

            var tipo = document.getElementById("tipo").value;

            document.getElementById("camionCampos").style.display = "none";
            document.getElementById("automovilCampos").style.display = "none";
            document.getElementById("motocicletaCampos").style.display = "none";

            if (tipo === "Camion") {
                document.getElementById("camionCampos").style.display = "block";
            }

            if (tipo === "Automovil") {
                document.getElementById("automovilCampos").style.display = "block";
            }

            if (tipo === "Motocicleta") {
                document.getElementById("motocicletaCampos").style.display = "block";
            }
        }

    </script>

}